{
  "name": "easy-bundler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "start": "npm run build && npm run preview",
    "build:preview": "npm run build && npm run preview",
    "lint": "eslint src/**/*.{ts,js}",
    "lint:fix": "eslint src/**/*.{ts,js} --fix",
    "lint:styles": "stylelint \"src/**/*.{css,scss}\"",
    "lint:styles:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "lint:all": "npm run lint && npm run lint:styles",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepare": "husky",
    "precommit": "lint-staged"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "eslint --fix"
    ],
    "src/**/*.{css,scss}": [
      "stylelint --fix"
    ]
  },
  "devDependencies": {
    "@cloudflare/playwright-mcp": "^0.0.2",
    "@executeautomation/playwright-mcp-server": "^1.0.4",
    "@jest/globals": "^30.1.2",
    "@modelcontextprotocol/server-filesystem": "^2025.8.21",
    "@modelcontextprotocol/server-sequential-thinking": "^2025.7.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.2.1",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@upstash/context7-mcp": "^1.0.17",
    "eslint": "^9.36.0",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "lint-staged": "^16.2.1",
    "sass-embedded": "^1.86.3",
    "stylelint": "^16.24.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "ts-jest": "^29.4.4",
    "typescript": "^5.9.2",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "lodash-es": "^4.17.21",
    "normalize.css": "^8.0.1",
    "uuid": "^11.1.0",
    "vite-plugin-handlebars": "^1.5.0"
  }
}
